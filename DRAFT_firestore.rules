rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Global Safety Net ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Definitions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAppOwner() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'karimazondomike049@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "AppOwner")
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isWorkspaceMaster(workspaceId) {
      return isSignedIn() && (
        isAppOwner() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().workspaceId == workspaceId && 
         (getUserData().role == "WorkspaceMaster" || getUserData().role == "Admin" || getUserData().role == "administrator"))
      );
    }

    function isWorkspaceMember(workspaceId) {
      return isSignedIn() && (
        isAppOwner() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().workspaceId == workspaceId)
      );
    }

    function isAgent() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        (getUserData().role == "Agent" || getUserData().role == "fieldagent")
      );
    }

    // --- Entity Validation Functions ---
    function isValidWorkspace(data) {
      return data.id is string && data.id.size() <= 100 &&
             data.name is string && data.name.size() <= 100 &&
             data.subscriptionTier is string &&
             data.isActive is bool &&
             data.ownerId is string;
    }

    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 150 &&
             data.role is string &&
             data.workspaceId is string &&
             data.name is string && data.name.size() <= 100;
    }

    function isValidVoucher(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.code is string && data.code.size() <= 100 &&
             data.plan is string &&
             data.price is number &&
             data.duration is string &&
             data.location is string &&
             data.status is string;
    }

    function isValidVoucherRequest(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.agentId is string &&
             data.agentName is string &&
             data.plan is string &&
             data.quantity is number &&
             data.status is string;
    }

    function isValidCashDrop(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.agentId is string &&
             data.amount is number &&
             data.status is string;
    }

    function isValidLegacyDevice(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.customerName is string && data.customerName.size() <= 100 &&
             data.deviceNameModel is string &&
             data.macAddress is string &&
             data.monthlyPrice is number &&
             data.fieldAgentId is string &&
             data.isApproved is bool;
    }

    // --- SaaS configurations ---
    match /saas_config/{configId} {
      allow read: if true;
      allow write: if isAppOwner();
    }

    // --- Audit Logs ---
    match /audit_logs/{auditLogId} {
      allow read: if isAppOwner();
      allow write: if isSignedIn();
    }

    match /workspaces/{workspaceId}/audit_logs/{auditLogId} {
      allow read: if isAppOwner() || isWorkspaceMaster(workspaceId);
      allow write: if isSignedIn();
    }

    // --- Archived Workspaces ---
    match /archived_workspaces/{workspaceId} {
      allow read, write: if isAppOwner();
    }

    // --- Workspaces ---
    match /workspaces/{workspaceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAppOwner() || isWorkspaceMaster(workspaceId);

      // --- Workspace Subcollections ---
      
      match /users/{userId} {
        allow read: if isWorkspaceMember(workspaceId) || isAppOwner();
        allow create: if isWorkspaceMaster(workspaceId) || isAppOwner() || (isSignedIn() && request.auth.uid == userId);
        allow update: if isWorkspaceMaster(workspaceId) || isAppOwner() || (
          isSignedIn() && request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'workspaceId', 'performanceScore'])
        );
        allow delete: if isWorkspaceMaster(workspaceId) || isAppOwner();
      }

      match /vouchers/{voucherId} {
        allow read: if isWorkspaceMember(workspaceId) && (
          isAppOwner() || 
          isWorkspaceMaster(workspaceId) || 
          resource.data.assignedAgentId == request.auth.uid
        );
        allow create, delete: if isWorkspaceMaster(workspaceId) || isAppOwner();
        allow update: if isWorkspaceMaster(workspaceId) || isAppOwner() || (
          isAgent() && 
          resource.data.assignedAgentId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'code', 'plan', 'price', 'assignedAgentId'])
        );
      }

      match /requests/{requestId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceMember(workspaceId);
        allow update: if isWorkspaceMaster(workspaceId) || isAppOwner() || (
          isAgent() && 
          resource.data.agentId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'agentId', 'status'])
        );
        allow delete: if isWorkspaceMaster(workspaceId) || isAppOwner();
      }

      match /cash_drops/{cashDropId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceMember(workspaceId);
        allow update: if isWorkspaceMaster(workspaceId) || isAppOwner() || (
          isAgent() && 
          resource.data.agentId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'agentId', 'status'])
        );
        allow delete: if isWorkspaceMaster(workspaceId) || isAppOwner();
      }

      match /legacy_devices/{deviceId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceMember(workspaceId);
        allow update: if isWorkspaceMaster(workspaceId) || isAppOwner() || (
          isAgent() && 
          resource.data.fieldAgentId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'isApproved', 'addedToInventory', 'fieldAgentId'])
        );
        allow delete: if isWorkspaceMaster(workspaceId) || isAppOwner();
      }

      match /notifications/{notificationId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow write: if isWorkspaceMaster(workspaceId) || isAppOwner();
      }

      match /feedback/{feedbackId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceMember(workspaceId);
        allow update: if isWorkspaceMaster(workspaceId) || isAppOwner() || (
          isAgent() && 
          resource.data.agentId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'agentId'])
        );
        allow delete: if isWorkspaceMaster(workspaceId) || isAppOwner();
      }
    }

    // --- Global Root Collections (Fallback support for multi-tenant and profile sync) ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAppOwner() || (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.workspaceId == resource.data.workspaceId
      ));
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userId || isAppOwner() || (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.workspaceId == resource.data.workspaceId &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "WorkspaceMaster" || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Admin")
      )) && (
        request.auth.uid != userId ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'workspaceId', 'performanceScore'])
      );
      allow delete: if isAppOwner();
    }

    match /vouchers/{voucherId} {
      allow read: if isSignedIn() && (
        isAppOwner() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().role == "WorkspaceMaster" || getUserData().role == "Admin" ||
          resource.data.assignedAgentId == request.auth.uid
        ))
      );
      allow write: if isAppOwner() || (isSignedIn() && (
        getUserData().role == "WorkspaceMaster" || getUserData().role == "Admin"
      ));
    }

    // --- CollectionGroup rules for queries ---
    match /{path=**}/users/{userId} {
      allow read, write: if isSignedIn();
    }

    match /{path=**}/vouchers/{voucherId} {
      allow read: if isSignedIn() && (
        isAppOwner() ||
        !isAgent() ||
        resource.data.assignedAgentId == request.auth.uid
      );
      allow write: if isAppOwner() || (isSignedIn() && !isAgent());
    }

    match /{path=**}/audit_logs/{logId} {
      allow read: if isAppOwner();
      allow write: if isSignedIn();
    }
  }
}
